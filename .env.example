# Azure AI Foundry configuration for gpt-realtime
# Authentication uses DefaultAzureCredential (az login / Managed Identity / VS Code / etc.)
# The signed-in identity needs the "Cognitive Services OpenAI User" role on the Foundry resource.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-realtime-1.5
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Optional: tenant hint for local auth or Entra-restricted environments
# AZURE_TENANT_ID=<tenant-guid>

# Optional: set only when the Azure Container App should use a specific
# user-assigned managed identity. If unset, DefaultAzureCredential can use
# system-assigned managed identity when available.
# AZURE_CLIENT_ID=<user-assigned-managed-identity-client-id>

# Required for Azure-hosted WebRTC scenarios such as Azure Container Apps.
# These are not usually needed for localhost development.
# CLOUDFLARE_TURN_KEY_ID=<cloudflare-turn-key-id>
# CLOUDFLARE_TURN_KEY_API_TOKEN=<cloudflare-turn-api-token>
