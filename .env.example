# Azure AI Speech
# Dedicated Speech resource endpoint, not the Azure OpenAI endpoint.
AZURE_SPEECH_ENDPOINT=https://your-speech-resource.cognitiveservices.azure.com/

# Azure OpenAI chat deployment (a chat model, not a realtime deployment)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Optional: pin DefaultAzureCredential to a user-assigned managed identity.
AZURE_CLIENT_ID=<managed-identity-client-id>

# Optional: restrict which credential types DefaultAzureCredential tries (comma-separated)
AZURE_TENANT_ID=<tenant-id>

GRADIO_HOST=127.0.0.1
GRADIO_PORT=7860
